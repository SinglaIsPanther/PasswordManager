<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_web_access_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_web_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:padding="8dp"
                    android:src="@drawable/ic_back" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Computer Web Access"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="कंप्यूटर Chrome से पासवर्ड देखें व जोड़ें"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Status Pill Badge -->
                <TextView
                    android:id="@+id/text_server_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_card"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Server Stopped"
                    android:textColor="@color/error_red"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 1: Server Control & URL -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_rounded_card"
                            android:contentDescription="Server"
                            android:padding="6dp"
                            android:src="@drawable/ic_shield_lock"
                            app:tint="@color/primary_blue" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="लोकल वेब सर्वर नियंत्रण"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Wi-Fi / VPN पर Chrome से सीधा कनेक्शन"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Dedicated Full-Width Start / Stop Server Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_toggle_web_server"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/primary_blue"
                        android:text="सर्वर चालू करें (Start Server)"
                        android:textAllCaps="false"
                        android:textColor="@color/surface_white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:elevation="2dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="@color/divider_color" />

                    <!-- Local Wi-Fi URL container -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="लोकल Wi-Fi एक्सेस URL (Computer के Chrome में खोलें):"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_rounded_card"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <!-- Line 1: Full URL -->
                        <TextView
                            android:id="@+id/text_web_local_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="http://192.168.1.xxx:xxxx"
                            android:textColor="@color/primary_blue"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Line 2: Action Buttons (नया पोर्ट & कॉपी) on next line -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_change_port"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:minWidth="0dp"
                                android:text="नया पोर्ट"
                                android:textColor="@color/text_secondary"
                                app:icon="@drawable/ic_refresh"
                                app:iconSize="14dp"
                                app:iconTint="@color/text_secondary" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_copy_local_url"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginStart="8dp"
                                android:minWidth="0dp"
                                android:text="कॉपी"
                                android:textColor="@color/primary_blue"
                                app:icon="@drawable/ic_copy"
                                app:iconSize="14dp"
                                app:iconTint="@color/primary_blue" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- VPN IP Address row -->
                    <LinearLayout
                        android:id="@+id/layout_vpn_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="रिमोट VPN URL (Tailscale / WireGuard):"
                            android:textColor="@color/text_hint"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/text_web_vpn_url"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="VPN कनेक्टेड नहीं है (केवल लोकल Wi-Fi पर उपलब्ध)"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Online Web Vault (GitHub Pages) -->
                    <LinearLayout
                        android:id="@+id/layout_github_web_vault"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_rounded_card"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌐 ऑनलाइन वेब वॉल्ट (GitHub Pages Web Link):"
                            android:textColor="@color/primary_blue"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_github_web_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="https://singlaispanther.github.io/PasswordManager/"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="मोबाइल (SIM नेट) व PC (ब्रॉडबैंड) अलग होने पर भी यह लिंक Chrome में खोलें।"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <!-- Dedicated Scan PC QR Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_scan_github_qr"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="@color/accent_gold"
                            android:text="📷 PC का QR कोड स्कैन करें (Scan QR)"
                            android:textAllCaps="false"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:elevation="2dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_share_github_url"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:minWidth="0dp"
                                android:text="शेयर करें"
                                android:textColor="@color/text_secondary" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_copy_github_url"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:minWidth="0dp"
                                android:text="कॉपी करें"
                                android:textColor="@color/primary_blue"
                                app:icon="@drawable/ic_copy"
                                app:iconSize="14dp"
                                app:iconTint="@color/primary_blue" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_open_github_url"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:minWidth="0dp"
                                android:text="खोलें"
                                android:textColor="@color/primary_blue"
                                app:icon="@drawable/ic_open_in_new"
                                app:iconSize="14dp"
                                app:iconTint="@color/primary_blue" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: QR Code & Temporary Pairing Code -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_pairing_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ब्राउज़र पेयरिंग कोड"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Computer के Chrome में यह कोड डालें या QR Code स्कैन करें:"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- Big 6-digit Code Box -->
                    <TextView
                        android:id="@+id/text_web_pairing_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_rounded_card"
                        android:letterSpacing="0.2"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="10dp"
                        android:text="482 910"
                        android:textColor="@color/primary_blue"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_pairing_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="वैधता: 04:59"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp" />

                    <!-- QR Code Bitmap Container -->
                    <ImageView
                        android:id="@+id/img_web_qr_code"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_rounded_card"
                        android:contentDescription="Pairing QR Code"
                        android:padding="8dp" />

                    <!-- Step by step instructions box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_rounded_card"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="कंप्यूटर Chrome से कनेक्ट करने के 3 आसान चरण:"
                            android:textColor="@color/primary_blue"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="1. कंप्यूटर के Google Chrome में ऊपर दिया URL खोलें।"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="2. Chrome स्क्रीन पर यह 6-अंकीय कोड डालें (अथवा QR स्कैन करें)।"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="3. मोबाइल में दिखने वाले डायलॉग में 'स्वीकार करें (Allow)' दबाएं।"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_refresh_pairing_code"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginTop="8dp"
                        android:text="नया कोड बनाएं (Refresh Code)"
                        android:textColor="@color/primary_blue"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_refresh"
                        app:iconSize="14dp"
                        app:iconTint="@color/primary_blue" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Paired Computers List -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="पेयर किए गए कंप्यूटर्स (Paired Browsers)"
                android:textColor="@color/primary_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/layout_paired_devices_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/text_no_paired_devices"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:padding="16dp"
                        android:text="कोई कंप्यूटर पेयर नहीं है। ऊपर दिए गए URL से पेयर करें।"
                        android:textColor="@color/text_hint"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
