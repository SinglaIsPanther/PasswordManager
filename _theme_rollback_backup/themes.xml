<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Application Theme (Light Material3) -->
    <style name="Theme.PasswordManager" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryVariant">@color/primary_blue_dark</item>
        <item name="colorOnPrimary">@color/surface_white</item>
        
        <item name="colorSecondary">@color/success_green</item>
        <item name="colorOnSecondary">@color/surface_white</item>

        <item name="android:statusBarColor">@color/surface_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface_white</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:windowBackground">@color/bg_light</item>
    </style>

    <!-- Fullscreen Viewer Theme -->
    <style name="Theme.PasswordManager.FullScreen" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">#000000</item>
    </style>
</resources>
